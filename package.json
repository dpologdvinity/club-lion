{
  "name": "club-lion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none src/game.test.ts src/components/mangoPattern.test.ts src/beeStop.test.ts",
    "format:check": "prettier --check src tests index.html vite.config.ts playwright.config.ts DESIGN.md UX-CONTRACT.md README.md",
    "format": "prettier --write src tests index.html vite.config.ts playwright.config.ts DESIGN.md UX-CONTRACT.md README.md",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "3.9.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
