{
  "name": "club-lion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-isolation=none \"src/**/*.test.ts\"",
    "format:check": "prettier --check src tests index.html vite.config.ts playwright.config.ts DESIGN.md UX-CONTRACT.md README.md ARCHITECTURE.md",
    "format": "prettier --write src tests index.html vite.config.ts playwright.config.ts DESIGN.md UX-CONTRACT.md README.md ARCHITECTURE.md",
    "test:e2e": "playwright test",
    "verify": "npm test && npm run typecheck && npm run format:check && npm run build",
    "test:pwa": "playwright test -c playwright.pwa.config.ts"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "3.10.0",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
